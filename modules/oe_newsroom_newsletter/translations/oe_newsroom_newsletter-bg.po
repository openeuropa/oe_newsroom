msgid "Your e-mail"
msgstr "Вашият електронен адрес"

msgid "Select the language in which you want to receive the newsletters"
msgstr "Изберете езика, на който желаете да получавате бюлетините"

msgid "By checking this box, I confirm that I want to register for this service, and I agree with the @privacy_link"
msgstr "С поставянето на отметка в тази кутийка потвърждавам, че искам да се регистрирам за тази услуга, и приемам @privacy_link"

msgid "privacy statement"
