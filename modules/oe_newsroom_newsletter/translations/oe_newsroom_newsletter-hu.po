msgid "Please select the newsletter lists you want to subscribe to."
msgstr "Kérjük, válassza ki azokat a hírleveleket, amelyekre fel kíván iratkozni."

msgid "Unsubscribe"
msgstr "Leiratkozás"

msgid "Successfully unsubscribed!"
msgstr "Ön sikeresen leiratkozott!"

msgid "Please select the newsletter lists you want to unsubscribe from."
msgstr "Kérjük, válassza ki azokat a hírleveleket, amelyekről le kíván iratkozni."
