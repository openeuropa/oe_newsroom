msgid "Your e-mail"
msgstr "Az Ön e-mail-címe"

msgid "Select the language in which you want to receive the newsletters"
msgstr "Válassza ki azt a nyelvet, amelyen a hírlevelet meg szeretné kapni"

msgid "By checking this box, I confirm that I want to register for this service, and I agree with the @privacy_link"
msgstr "E négyzet bejelölésével megerősítem, hogy igényt tartok erre a szolgáltatásra, és elfogadom az @privacy_link"

msgid "privacy statement"
msgstr "adatvédelmi nyilatkozatot"

msgid "Subscribe"
msgstr "Feliratkozás"

