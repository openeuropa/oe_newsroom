msgid "Your e-mail"
msgstr "Váš e-mail"

msgid "Select the language in which you want to receive the newsletters"
msgstr "Vyberte jazyk, v ktorom chcete odoberať informačné bulletiny"

msgid "By checking this box, I confirm that I want to register for this service, and I agree with the @privacy_link"
msgstr "Zaškrtnutím tohto políčka potvrdzujem, že sa chcem na túto službu zaregistrovať a že súhlasím s @privacy_link"

msgid "privacy statement"
