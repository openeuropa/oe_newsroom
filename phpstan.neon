parameters:
  # Drupal 10.6 uses PHPStan 1, which does not report these PHPStan 2 rules.
  # Do not fail that CI matrix entry when an ignore has no matching diagnostic.
  reportUnmatchedIgnoredErrors: false
  ignoreErrors:
    - identifier: dependencySerializationTraitProperty.unsupportedReadOnlyProperty
    - identifier: dependencySerializationTraitProperty.unsupportedPrivateProperty
    - identifier: new.static
    # Hook attributes are introduced in Drupal 11; CI also tests Drupal 10.6.
    -
      message: '#^Attribute class Drupal\\Core\\Hook\\Attribute\\Hook does not exist\.$#'
      paths:
        - modules/oe_newsroom_node/src/Hook/NewsroomSettingsFormAlter.php
